# ElcomCLI Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to git!

EXPO_PUBLIC_OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
EXPO_PUBLIC_UPDATE_URL=https://cli.elcomlab.site/version.json
EXPO_PUBLIC_OPENROUTER_KEYS_URL=https://openrouter.ai/keys
EXPO_PUBLIC_LANDING_PAGE_URL=https://cli.elcomlab.site
EXPO_PUBLIC_MODELS_URL=https://cli.elcomlab.site/models.json
EXPO_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id
EXPO_PUBLIC_GITHUB_CLIENT_SECRET=your_github_client_secret
